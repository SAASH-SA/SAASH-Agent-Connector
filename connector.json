{
  "schema": "saash.agent-connector.install.v1",
  "version": "0.3.3",
  "name": "SAASH Agent Connector",
  "description": "Saudi HRSD/MHRSD, Qiwa, Ajeer, Musaned, workforce and legal service discovery in Arabic and English.",
  "base_url": "https://saash-gateway.vercel.app",
  "discovery_path": "/api/v1/discovery",
  "manifest_path": "/.well-known/saash-agent-connector.json",
  "agent_card_path": "/.well-known/agent-card.json",
  "openapi_path": "/openapi.json",
  "apis_json_path": "/.well-known/apis.json",
  "api_catalog_path": "/.well-known/api-catalog",
  "resolve_path": "/api/v1/connector/resolve",
  "grow_invoke_path": "/api/v1/connector/invoke",
  "grow_experience_path": "/api/v1/grow/experiences",
  "grow_experience_schema_ref": "/openapi.json#/components/schemas/PublicExperienceSubmission",
  "grow_experience_rules": {
    "saash-workforce-engine_new_capability_prefix": "workforce.learned.",
    "saash-legal-engine_new_capability_prefix": "legal.learned.",
    "existing_capability_improvement_requires_same_invoked_capability": true,
    "invocation_must_match_receipt": true
  },
  "grow_experience_status_path_template": "/api/v1/grow/experiences/{experience_id}/status",
  "grow_experience_revoke_path_template": "/api/v1/grow/experiences/{experience_id}/revoke",
  "invoke_path": "/api/v1/invoke",
  "authentication": {
    "discovery": "NONE",
    "resolution": "NONE",
    "safe_grow_invocation": "NONE_WITH_EXPLICIT_ACKNOWLEDGEMENT_AND_RATE_LIMIT",
    "sanitized_experience_contribution": "NONE_WITH_SIGNED_SINGLE_USE_RECEIPT",
    "experience_status_and_revocation": "ONE_TIME_MANAGEMENT_SECRET_RETURNED_AT_ACCEPTANCE",
    "effectful_or_binding_invocation": "BEARER_GATEWAY_API_KEY"
  },
  "access_stage": "GROW",
  "price_minor": 0,
  "payment_collection": false,
  "capacity_policy": {
    "per_client_network_daily_invocation_limit": null,
    "provider_aligned_monthly_accepted_invocation_budget": 800000,
    "operating_reserve_percent": 20,
    "client_burst_per_minute": 60,
    "global_burst_per_minute": 600,
    "planning_budget_not_sla": true
  },
  "capability_pages": {
    "legal": "https://saash-gateway.vercel.app/saudi-legal-agent",
    "workforce": "https://saash-gateway.vercel.app/saudi-workforce-agent",
    "agent_learning": "https://saash-gateway.vercel.app/agent-learning"
  }
}
